{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://skyville.example/schemas/listing-data.schema.json",
  "title": "Listing Data",
  "description": "listings/{listing-id}/listing.json이 따라야 하는 스키마. index.html/script.js는 이 구조만 참조하므로, 새 호실을 추가할 때는 이 스키마를 만족하는 listing.json과 photos 폴더만 교체하면 된다.",
  "type": "object",
  "required": ["id", "title", "subtitle", "heroLead", "heroPhoto", "summary", "sections", "location", "contact", "finalCta", "footerNotice"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "title": { "type": "string", "minLength": 1 },
    "subtitle": { "type": "string", "minLength": 1 },
    "heroLead": { "type": "string", "minLength": 1 },
    "heroPhoto": { "$ref": "#/definitions/photo" },
    "summary": {
      "type": "object",
      "required": ["deposit", "monthlyRent", "maintenanceFee", "parkingFee", "floor", "areaPyeong", "moveInDate", "loanEligibility"],
      "additionalProperties": false,
      "properties": {
        "deposit": { "type": "string", "minLength": 1 },
        "monthlyRent": { "type": "string", "minLength": 1 },
        "maintenanceFee": { "type": "string", "minLength": 1 },
        "parkingFee": { "type": "string", "minLength": 1 },
        "floor": { "type": "string", "minLength": 1 },
        "areaPyeong": { "type": "string", "minLength": 1 },
        "moveInDate": { "type": "string", "minLength": 1 },
        "loanEligibility": { "type": "string", "minLength": 1 }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/sectionBlock" }
    },
    "location": {
      "type": "object",
      "required": ["address", "map"],
      "additionalProperties": false,
      "properties": {
        "address": { "type": "string", "minLength": 1 },
        "map": {
          "type": "object",
          "required": ["lat", "lng"],
          "additionalProperties": false,
          "properties": {
            "lat": { "type": "number" },
            "lng": { "type": "number" }
          }
        },
        "neighborhoodNote": { "type": "string" }
      }
    },
    "contact": {
      "type": "object",
      "required": ["kakaoId", "phone", "email"],
      "additionalProperties": false,
      "properties": {
        "kakaoId": { "type": "string", "minLength": 1 },
        "phone": { "type": "string", "pattern": "^[0-9-]+$" },
        "email": { "type": "string", "format": "email" }
      }
    },
    "finalCta": {
      "type": "object",
      "required": ["heading", "message", "buttons"],
      "additionalProperties": false,
      "properties": {
        "heading": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "buttons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["label", "action"],
            "additionalProperties": false,
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "action": { "type": "string", "enum": ["kakao-copy", "tel", "mailto"] }
            }
          }
        }
      }
    },
    "footerNotice": { "type": "string", "minLength": 1 }
  },
  "definitions": {
    "photo": {
      "type": "object",
      "required": ["src", "alt"],
      "additionalProperties": false,
      "properties": {
        "src": {
          "type": "string",
          "minLength": 1,
          "not": { "pattern": "^(https?:)?//" },
          "description": "상대 경로만 허용 (예: photos/room-wide-1.jpg). 절대 URL/외부 hotlink 금지."
        },
        "alt": { "type": "string", "minLength": 1 },
        "aspectRatio": { "type": "string", "default": "4/3" }
      }
    },
    "sectionBlock": {
      "type": "object",
      "required": ["key", "heading", "body", "photos"],
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "enum": ["room", "kitchen", "bathroom", "security", "amenities", "location", "fees", "trust"]
        },
        "heading": { "type": "string", "minLength": 1 },
        "body": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": { "type": "string", "minLength": 1 }
        },
        "photos": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": { "$ref": "#/definitions/photo" }
        },
        "keywords": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "specs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "value"],
            "additionalProperties": false,
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "value": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
